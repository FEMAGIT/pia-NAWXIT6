# Copiare questo file in ".env" (stessa cartella) e inserire i valori reali:
# settings.py lo carica all'avvio. Le variabili già presenti nell'ambiente
# del processo hanno la precedenza su quelle del file.
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# MySQL example. Omit these variables to use a local SQLite database.
DJANGO_DB_ENGINE=django.db.backends.mysql
DJANGO_DB_NAME=ics
DJANGO_DB_USER=ics_user
DJANGO_DB_PASSWORD=replace-with-a-database-password
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=3306

# Absolute path to a service-account JSON kept outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# DB di produzione SQL Server PIA_FEMA (schemi dbo, wms, NEXUM) letto da
# "python manage.py importa_fema". Esempio per il ripristino locale in Docker.
FEMA_DB_HOST=127.0.0.1
FEMA_DB_PORT=14333
FEMA_DB_NAME=PIA_FEMA
FEMA_DB_USER=sa
FEMA_DB_PASSWORD=replace-with-the-sql-server-password
FEMA_DB_TIMEZONE=Europe/Rome
