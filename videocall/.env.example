# Variabili d'ambiente lette da Ticketing_V2/settings.py.
# Il progetto non carica file .env da solo: in produzione si impostano
# nel blocco [program:...] di supervisor con `environment=`.

# Obbligatoria. Genera con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# True solo in sviluppo.
DJANGO_DEBUG=False

# Domini serviti, separati da virgola.
DJANGO_ALLOWED_HOSTS=videocall.example.com

# Database PostgreSQL.
DB_NAME=videocall
DB_USER=videocall
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Indirizzi pubblici del servizio.
VIDEOCALL_BASE_URL=https://videocall.example.com/
VIDEOCALL_WS_BASE_URL=wss://videocall.example.com

# Token per la registrazione automatica di nuovi occhiali; vuoto = disattivata.
SMARTGLASS_REGISTRATION_TOKEN=
